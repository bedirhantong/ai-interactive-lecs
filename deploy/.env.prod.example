# Production settings for deploy/compose.prod.yml. Copy to deploy/.env.prod (never commit it).

# Your domain. Caddy obtains an HTTPS certificate for it automatically (ports 80/443 must be reachable).
SITE_ADDRESS=atolye.example.com

# Generate each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
ATOLYE_SECRET_KEY=

# Optional ---------------------------------------------------------------------
# Public GitHub repo with content/colab/*.ipynb, enables "Google Colab'da Aç".
NEXT_PUBLIC_COLAB_GITHUB_REPO=
# API worker processes (about 1-2 per CPU core).
WEB_CONCURRENCY=2
# Data retention (see docs/KVKK_NOTLARI.md). Empty = inactive-account deletion disabled.
ATOLYE_AUDIT_RETENTION_DAYS=365
ATOLYE_INACTIVE_STUDENT_RETENTION_DAYS=
# Image tag (e.g. a git commit) so you can roll back to a previous build.
IMAGE_TAG=latest
