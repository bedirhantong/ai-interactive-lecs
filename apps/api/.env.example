# Copy to apps/api/.env. All variables use the ATOLYE_ prefix.
ATOLYE_ENV=development
# PostgreSQL from docker-compose.yml (host port 5433). For a quick local try without Docker:
# ATOLYE_DATABASE_URL=sqlite:///./dev.db
ATOLYE_DATABASE_URL=postgresql+psycopg://atolye:atolye@localhost:5433/atolye
ATOLYE_ALLOWED_ORIGINS=http://localhost:3000
# Throwaway demo accounts without passwords. Refused when ATOLYE_ENV=production.
ATOLYE_DEMO_MODE=true
ATOLYE_COOKIE_SECURE=false
ATOLYE_SESSION_TTL_HOURS=12
# Keys the HMAC hashes of login names and IPs (rate limiting). Required (32+ random chars) in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATOLYE_SECRET_KEY=
# Brute-force protection (defaults shown)
# ATOLYE_LOGIN_WINDOW_MINUTES=15
# ATOLYE_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# ATOLYE_LOGIN_MAX_FAILURES_PER_IP=30
# ATOLYE_DEMO_MAX_PER_IP_PER_HOUR=20
# Data retention (KVKK). See docs/KVKK_NOTLARI.md before changing.
# ATOLYE_AUDIT_RETENTION_DAYS=365
# Delete student accounts with no login for N days. Disabled unless set; the school decides the period.
# ATOLYE_INACTIVE_STUDENT_RETENTION_DAYS=
