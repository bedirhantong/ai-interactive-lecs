# Copy to apps/web/.env.local. Everything here is public (NEXT_PUBLIC_*): never put secrets in this file.

# Public GitHub repository that hosts content/colab/*.ipynb, e.g. "kullanici/ai-atolye".
# When set, Colab Lab cells show "Google Colab'da Aç". Without it, students download the notebook.
NEXT_PUBLIC_COLAB_GITHUB_REPO=
NEXT_PUBLIC_COLAB_GITHUB_BRANCH=main

# Self-host Pyodide by pointing this at your own copy (must end with /).
# NEXT_PUBLIC_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/
